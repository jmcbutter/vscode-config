{
	// Place your snippets for liquid here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"Insert Block Schema": {
		"prefix": "schema-block",
		"body": [
			"{% schema %}",
			"{",
			"\t\"name\": \"${1:name}\",",
			"\t\"tag\": \"${2:tag}\",",
			"\t\"blocks\": [{ \"type\": \"${3:blocks}\" }],",
			"\t\"settings\": [",
			"\t\t{",
			"\t\t\t\"type\": \"range\",",
			"\t\t\t\"id\": \"padding_top\",",
			"\t\t\t\"min\": 0,",
			"\t\t\t\"max\": 20,",
			"\t\t\t\"step\": 0.5,",
			"\t\t\t\"unit\": \"rem\",",
			"\t\t\t\"label\": \"Top padding (desktop)\",",
			"\t\t\t\"default\": 3,",
			"\t\t},",
			"\t\t{",
			"\t\t\t\"type\": \"range\",",
			"\t\t\t\"id\": \"padding_bottom\",",
			"\t\t\t\"min\": 0,",
			"\t\t\t\"max\": 20,",
			"\t\t\t\"step\": 0.5,",
			"\t\t\t\"unit\": \"rem\",",
			"\t\t\t\"label\": \"Bottom padding (desktop)\",",
			"\t\t\t\"default\": 3,",
			"\t\t},",
			"\t\t{",
			"\t\t\t\"type\": \"range\",",
			"\t\t\t\"id\": \"mobile_padding_top\",",
			"\t\t\t\"min\": 0,",
			"\t\t\t\"max\": 20,",
			"\t\t\t\"step\": 0.5,",
			"\t\t\t\"unit\": \"rem\",",
			"\t\t\t\"label\": \"Top padding (mobile)\",",
			"\t\t\t\"default\": 3,",
			"\t\t},",
			"\t\t{",
			"\t\t\t\"type\": \"range\",",
			"\t\t\t\"id\": \"mobile_padding_bottom\",",
			"\t\t\t\"min\": 0,",
			"\t\t\t\"max\": 20,",
			"\t\t\t\"step\": 0.5,",
			"\t\t\t\"unit\": \"rem\",",
			"\t\t\t\"label\": \"Bottom padding (mobile)\",",
			"\t\t\t\"default\": 3,",
			"\t\t},",
			"\t],",
			"\t\"presets\": [",
			"\t\t{",
			"\t\t\t\"name\": \"${1: name}\",",
			"\t\t}",
			"\t]",
			"}",
			"{% endschema %}"
		]
	},
	"Insert Block ID Style": {
		"prefix": "style-block",
		"body": [
			"{% style %}",
			"\t.block-{{ block.id }}-padding {",
			"\t\tpadding-top: {{ block.settings.mobile_padding_top }}rem;",
			"\t\tpadding-bottom: {{ block.settings.mobile_padding_bottom }}rem;",
			"\t}",
			"",
			"\t@media screen and (min-width: 1024px) {",
			"\t\t.block-{{ block.id }}-padding {",
			"\t\t\tpadding-top: {{ block.settings.padding_top }}rem;",
			"\t\t\tpadding-bottom: {{ block.settings.padding_bottom }}rem;",
			"\t\t}",
			"\t}",
			"{% endstyle %}",
			"",
			"<div class='block-{{ block.id }}'>${0}</div>"
		]
	}
}
